# ===== 复制本文件为 .env 并填写真实值 =====

# -------- 应用配置 --------
APP_NAME=ruoyi-ai-service
APP_HOST=0.0.0.0
APP_PORT=9090
APP_RELOAD=true
APP_VERSION=1.0.0
APP_ROOT_PATH=/dev-api

# -------- JWT配置 --------
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

# -------- 数据库配置 --------
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_DATABASE=ruoyi-fastapi
DB_ECHO=true
DB_MAX_OVERFLOW=10
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30

# -------- Redis配置 --------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=3

# -------- 日志配置 --------
LOG_LEVEL=INFO
LOG_DIR=logs

# -------- LLM配置（通义千问，兼容 OpenAI 协议） --------
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=qwen3-max

# -------- Milvus 向量数据库配置 --------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# 云服务时填写
# MILVUS_URI=https://your-instance-id.milvus.aliyuncs.com
# MILVUS_TOKEN=your_api_token_here
MILVUS_COLLECTION=ai_embeddings
MILVUS_DIMENSION=1024
MILVUS_INDEX_TYPE=AUTOINDEX
MILVUS_METRIC_TYPE=COSINE
MILVUS_TIMEOUT=30
